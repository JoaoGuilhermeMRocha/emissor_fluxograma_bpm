    "morphdom": "^2.7.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
