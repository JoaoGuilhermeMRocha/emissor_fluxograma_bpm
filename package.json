{
  "name": "mapeador-processos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Mapeador de Processos: HTML, CSS e JS puros no navegador. O Node só instala dependências, prepara a pasta web/vendor e roda os testes.",
