<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_0x1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Empresa" name="Compra de Materiais" processRef="Process_Compras" />
    <bpmn:participant id="Participant_Fornecedor" name="Fornecedor" />
    <bpmn:messageFlow id="MsgFlow_1" sourceRef="Activity_Cotar" targetRef="Participant_Fornecedor" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Compras" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sol" name="Solicitante">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Abrir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comp" name="Compras">
        <bpmn:flowNodeRef>Activity_Cotar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Junta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Prazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fin" name="Financeiro">
        <bpmn:flowNodeRef>Activity_Aprovar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Pagar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Necessidade identificada" />
    <bpmn:userTask id="Activity_Abrir" name="Abrir requisição" />
    <bpmn:subProcess id="Activity_Cotar" name="Cotar com fornecedores">
      <bpmn:startEvent id="Sub_Start" />
      <bpmn:task id="Sub_Pedir" name="Pedir cotação" />
      <bpmn:endEvent id="Sub_End" />
      <bpmn:sequenceFlow id="Sub_F1" sourceRef="Sub_Start" targetRef="Sub_Pedir" />
      <bpmn:sequenceFlow id="Sub_F2" sourceRef="Sub_Pedir" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_Prazo" name="Prazo de 5 dias" attachedToRef="Activity_Cotar">
      <bpmn:timerEventDefinition id="Timer_1" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_Cancelado" name="Requisição cancelada" />
    <bpmn:exclusiveGateway id="Gateway_Valor" name="Valor acima de R$ 5 mil?" />
    <bpmn:userTask id="Activity_Aprovar" name="Aprovar orçamento">
      <bpmn:documentation>Conferir centro de custo</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Junta" />
    <bpmn:serviceTask id="Activity_Pedido" name="Emitir pedido no ERP" />
    <bpmn:scriptTask id="Activity_Pagar" name="Programar pagamento" />
    <bpmn:endEvent id="EndEvent_1" name="Pedido emitido" />
    <bpmn:dataObjectReference id="DataRef_1" name="Requisição" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_Abrir" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Abrir" targetRef="Activity_Cotar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Cotar" targetRef="Gateway_Valor" />
    <bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="Gateway_Valor" targetRef="Activity_Aprovar" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="Gateway_Valor" targetRef="Gateway_Junta" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Aprovar" targetRef="Gateway_Junta" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Junta" targetRef="Activity_Pedido" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_Pedido" targetRef="Activity_Pagar" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Pagar" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_Prazo" targetRef="Event_Cancelado" />
    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>Mínimo de 3 cotações</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Activity_Cotar" targetRef="TextAnnotation_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
